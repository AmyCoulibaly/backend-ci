# Configuration de l'environnement de production / Docker Compose
FLASK_ENV=production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGEZ_MOI_mot_de_passe_fort>
POSTGRES_DB=esante_senegal_prod

SECRET_KEY=<CHANGEZ_MOI_cle_secrete_flask_min_32_caracteres>
JWT_SECRET_KEY=<CHANGEZ_MOI_cle_jwt_min_32_caracteres>
JWT_EXPIRES_HOURS=24

# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:80,http://localhost:5173

# URL de connexion PostgreSQL
# En Docker Compose, cette variable est construite automatiquement.
# En déploiement manuel, décommentez et renseignez :
DATABASE_URL=postgresql://postgres:<MOT_DE_PASSE>@localhost:5432/esante_senegal_prod
